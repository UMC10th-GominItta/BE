# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# DB - name : gominitta_db
DB_URL=jdbc:mysql://localhost:3306/gominitta_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USER=root
DB_PASSWORD=1234

# OpenAI (음성 기록 STT / 걱정 카테고리 분류)
OPENAI_API_KEY=

# Google Cloud Vision (필기 기록 OCR)
GOOGLE_VISION_API_KEY=

# 로컬 파일 저장 (음성/필기 기록 공용, dev 프로필에서만 사용)
FILE_UPLOAD_DIR=uploads/records
FILE_BASE_URL=http://localhost:8080/media/records

# 미디어 URL 서명 시크릿 (mediaUrl 접근 시 서명/만료 검증용, 운영에서는 반드시 별도 값으로 교체)
MEDIA_SIGNING_SECRET=local-dev-media-signing-secret-change-me

# AWS S3 (prod 프로필에서만 사용, 배포 담당자에게 값 전달받아 채우기)
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
